# Replit project configuration for CXOps.
#
# ONE project, TWO deployments, ONE development Run command.
#
# TOML DISCIPLINE -- READ BEFORE EDITING
#
# This file is TOML, and TOML forbids defining the same key twice. A top-level
# `run = "..."` and a `[[run]]` array of tables are the same key, so writing
# both is a parse error, not a style preference:
#
#     Cannot overwrite a value (at line 36, column 6)
#
# Replit surfaces that as the workspace refusing to load, and a workspace that
# refuses to load gets reset to the last commit on origin/master. That is what
# turned a one-line authoring mistake into a fight where good Replit-side fixes
# kept reappearing broken: the reset was working as designed, discarding local
# edits and restoring the invalid file.
#
# So the rule this file now obeys:
#
#   * top-level `run`     -> the ONE development Run command, a plain string.
#                            It is never mixed with a `[[run]]` table.
#   * `[deployment] run`  -> which Run the *deployment* starts. Different table
#                            scope, so it does not collide with the above.
#
# There are no `[[run]]` tables in this file, and the regression test in
# tests/test_replit_config.py fails the build if one is added back.
#
#   deployment      run command                        published port
#   -------------   --------------------------------   ---------------
#   cxops-web       scripts/start_replit_web.sh       yes (PORT)
#   cxops-worker    scripts/start_replit_worker.sh    no
#
# The worker is a separate deployment, not a second entry in the web
# deployment's run list. One consumer per deployment is the intended shape: a
# job consumer inside every web replica multiplies consumers by the replica
# count. Its Run command is not referenced from this file -- it is selected when
# the worker deployment is created in the Replit UI.

# Runtime modules. These supply Python and Node, so they must NOT also be
# declared in the [nix] system-dependency list below: that is a redundant
# runtime declaration, and when the two disagree the later one wins silently.
#
# Note the spelling: `python-3.12`, not `python3-12`. Replit's module registry
# uses the hyphenated form, and a name that does not resolve leaves the project
# without the interpreter the app requires.
modules = ["python-3.12", "nodejs-22"]

# THE development Run command. Exactly one, as a plain string, and no [[run]]
# table anywhere in this file. Pressing Run in the workspace executes this.
#
# It is a development launcher, deliberately unlike the deployment path: no
# preflight, no production secrets, no migrations, and no frontend production
# build. Those are the web deployment's job, and a developer who cannot preview
# a change without first provisioning production credentials cannot iterate.
#
# PLACEMENT IS LOAD-BEARING. Everything above the first `[table]` header is
# top-level; anything after it belongs to that table. Writing this line below
# `[nix]` does not produce a top-level `run` at all -- it silently produces
# `nix.run`, and the file parses cleanly while Replit finds no Run command. All
# top-level keys therefore stay above the first table header, and
# tests/test_replit_config.py asserts `run` is genuinely at the top level rather
# than trusting its position in the file.
run = "bash scripts/start_replit_dev.sh"

# System packages only: a shell, a PostgreSQL client for the pgvector check, and
# the build/TLS pieces a from-source wheel fallback needs. Python and Node
# language runtimes come from `modules` above and their packages from
# requirements-lock.txt / package-lock.json.
#
# This list lives in `.replit` rather than a separate `replit.nix` on purpose.
# Replit's managed dependency tooling is what validates and exposes this form,
# and it is the form proven to parse in the live workspace. Two files declaring
# the same system dependencies is a second source of truth for the same thing,
# which is how the invalid nix attributes ended up committed in the first place:
# they were plausible-looking names in a file nothing was checking.
[nix]
array = [
  "bash",
  "postgresql_16",
  "pkg-config",
  "openssl",
  "cacert",
]

[env]
# Unbuffered stdout/stderr, so a crash message appears in the deployment log
# before the process dies instead of being lost in an 8KB stdio buffer.
PYTHONUNBUFFERED = "1"
# Telemetry is noise in a deploy log and is not something to opt into from a
# machine that holds production database credentials.
NEXT_TELEMETRY_DISABLED = "1"

[deployment]
# The web deployment only. This is a single run target, not a list.
#
# It was `["web", "worker"]`, which asked one deployment to start two
# long-running processes and would have made the worker scale with the web
# deployment's replica count -- the exact mistake the separate worker deployment
# exists to prevent. The worker is a separate deployment with its own Run
# command, selected when that deployment is created.
run = "scripts/start_replit_web.sh"

# No `deploymentTarget`, and none is substituted.
#
# The file said `deploymentTarget = "reservedvm"`. Replit's own schema validator
# rejected that value during live recovery and stripped the field, so it was
# never taking effect -- it was only ever a claim in a comment.
#
# Current Replit documentation does not support it, and supports no replacement
# here either. The documented [deployment] keys are `run`, `build`, and
# `ignorePorts`; `deploymentTarget` appears only in a legacy example whose one
# value is `cloudrun`. Reserved VM is a deployment type chosen in the Publishing
# tool's "Deployment type" dropdown, not a value set in this file.
#
# So the field is omitted rather than replaced. Guessing at a substitute ("vm",
# "autoscale") would put an unverified value into a file whose entire purpose is
# to be a validated source of truth, and would pick a deployment type and a
# billing model as a side effect of a config edit. The deployment type is
# selected in the UI when each deployment is created, which is where it belongs.
#
# If a future Replit release documents Reserved VM as a .replit value, add it
# then, from that documentation rather than from memory.

# No build command, deliberately.
#
# The obvious choice is a production config validation step, and it is wrong:
# that needs production secrets (https public URLs, AUTH_JWKS_URL,
# ENCRYPTION_KEYS) and a live database connection. A build step has neither --
# deployment secrets are injected into the running deployment, not into its
# build, and a private database is reachable from the deployment rather than
# from a build. So it would fail for a completely correct configuration, and the
# failure would read like a configuration fault rather than a misplaced check.
#
# There is also nothing to build here. The frontend build depends on
# CXOPS_PUBLIC_SITE_URL, a deployment environment variable, so it cannot run
# before the deployment exists. scripts/start_replit_web.sh builds at start time
# for exactly that reason, and runs the environment gate there too, before
# either server starts.
#
# The key is therefore OMITTED, not set to an empty value. It used to read
# `build = []`, written to mean "no build step" -- and Replit's schema takes
# `build` to be a command string, so an array is not a way of saying "none" but
# an invalid value. Publishing rejected the whole deployment config with "The
# .replit deployment configuration is invalid", which is a far worse failure than
# the one it was trying to express: it blocked the publish instead of describing
# an absent optional step.
#
# Do not reintroduce it in any form, including `build = ""`. Omit the key; that
# is how TOML expresses "no value", and it is what the schema expects.
# tests/test_replit_config.py fails the build if a `build` key reappears here.
