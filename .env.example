APP_NAME=CXOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://cxops:cxops@localhost:5432/cxops

# Authentication / Identity
# AUTH_MODE=hs256 (development) or jwks (production)
AUTH_MODE=hs256
# Replace with a JWT secret of at least 32 characters for production (hs256 mode).
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Set to true for local development with deterministic HS256 secret.
# MUST be false in production.
AUTH_DEV_MODE=false

# JWKS / OIDC configuration (required when AUTH_MODE=jwks)
# Example Nhost JWKS: https://<subdomain>.auth.<region>.nhost.run/v1/.well-known/jwks.json
AUTH_JWKS_URL=
# Comma-separated allowed algorithms (default RS256)
AUTH_JWKS_ALGORITHMS=RS256
# JWKS cache TTL in seconds (default 600)
AUTH_JWKS_CACHE_TTL_SECONDS=600

# Zendesk webhook signing secret.
ZENDESK_WEBHOOK_SECRET=

# Generic ticket-event webhook signing secret.
TICKET_EVENT_WEBHOOK_SECRET=

# Encryption at rest for Zendesk OAuth tokens and webhook secrets.
# Comma-separated Fernet keys (use Fernet.generate_key()); primary first.
# Required in production; optional in development (stores plaintext when absent).
ENCRYPTION_KEYS=

# Allow reading non-encrypted legacy secret values. Enable only during a
# deliberate migration window. Must be false in production after migration.
ENCRYPTION_ALLOW_LEGACY_PLAINTEXT=false

# Generic ticket-event webhook replay window in seconds (default 300).
GENERIC_WEBHOOK_REPLAY_WINDOW_SECONDS=300

ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_CLIENT_ID=your-client-id
# Replace with your Zendesk OAuth client secret.
ZENDESK_CLIENT_SECRET=
ZENDESK_REDIRECT_URI=http://127.0.0.1:8000/auth/zendesk/callback
ZENDESK_OAUTH_SCOPE=read write

# Replace with your OpenAI API key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_SIMILARITY_MARGIN=0.12
RAG_MAX_SOURCES=3

LLM_INPUT_COST_PER_MILLION=0.15
LLM_OUTPUT_COST_PER_MILLION=0.60

SUPPORT_HOURLY_COST_USD=25.0
MINUTES_SAVED_PER_AUTONOMOUS_EXECUTION=8.0

ROI_MIN_AUTONOMOUS_SAMPLES=20
# ---------------------------------------------------------------------------
# Public URLs (Phase 1P.3)
# ---------------------------------------------------------------------------
# Both must be https when ENVIRONMENT=production; the app refuses to start
# otherwise. FRONTEND_BASE_URL is what tenant onboarding embeds in the widget
# snippet, so it must be the real customer-facing origin of your website.
FRONTEND_BASE_URL=http://127.0.0.1:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Deployment (Phase 1P-Replit)
# ---------------------------------------------------------------------------
# The full production environment contract, with the reason each value exists,
# is config/replit/deployment-env.yaml. The two values below are the ones whose
# local value is actively *wrong* for the production topology, so they are called
# out rather than left to be discovered.

# uvicorn needs this to build correct absolute URLs and to trust
# X-Forwarded-Proto. On the Replit topology it MUST stay a specific value,
# normally 127.0.0.1: the API is bound to loopback and is reached only by the
# frontend on the same machine, so the only source whose forwarded headers are
# trustworthy is the local one. "*" is wrong here -- it would let anything able
# to open that socket dictate the scheme the app believes it is served over.
FORWARDED_ALLOW_IPS=127.0.0.1

# Port the platform assigns to the web deployment. Next.js binds this; FastAPI
# does not, because it stays on INTERNAL_API_PORT behind the frontend's BFF.
PORT=8000

# Loopback port for FastAPI. Not published.
INTERNAL_API_PORT=8000

# Prometheus listener inside the worker deployment. 0 disables it. Reachable
# only from inside the deployment.
WORKER_METRICS_PORT=9101
