APP_NAME=CXOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://cxops:cxops@localhost:5432/cxops

# Authentication / Identity
AUTH_JWT_SECRET=replace-with-jwt-secret-at-least-32-chars
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_DEV_MODE=false

ZENDESK_WEBHOOK_SECRET=replace-with-zendesk-signing-secret
TICKET_EVENT_WEBHOOK_SECRET=replace-with-ticket-event-webhook-signing-secret

ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_CLIENT_ID=your-client-id
ZENDESK_CLIENT_SECRET=your-client-secret
ZENDESK_REDIRECT_URI=http://127.0.0.1:8000/auth/zendesk/callback
ZENDESK_OAUTH_SCOPE=read write

OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_SIMILARITY_MARGIN=0.12
RAG_MAX_SOURCES=3

LLM_INPUT_COST_PER_MILLION=0.15
LLM_OUTPUT_COST_PER_MILLION=0.60

SUPPORT_HOURLY_COST_USD=25.0
MINUTES_SAVED_PER_AUTONOMOUS_EXECUTION=8.0

ROI_MIN_AUTONOMOUS_SAMPLES=20