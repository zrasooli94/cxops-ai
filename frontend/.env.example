# Backend API URL (proxied through Next.js)
BACKEND_API_URL=http://127.0.0.1:8000

# Nhost provider configuration (public identifiers, not secrets)
NEXT_PUBLIC_NHOST_SUBDOMAIN=qghtvniyltmrsaoxruwa
NEXT_PUBLIC_NHOST_REGION=ap-southeast-1

# Session cookie name
NHOST_SESSION_COOKIE=nhostSession

# Set to 'production' in production for Secure cookie flag
NODE_ENV=development